# Get a key at https://app.tavily.com (free plan: 1,000 credits/month)
TAVILY_API_KEY=tvly-your-key-here

# Optional
PORT=3000
# fast = lowest latency (1 credit), basic = 1 credit, advanced = 2 credits (slower)
SEARCH_DEPTH=fast
# Repeat searches within this window are served from memory (no credits used)
CACHE_MINUTES=30

# ZooWork project key (zwp_live_...) from https://platform.zoowork.ai
# When set, a ZooWork agent opens each store page and confirms the price.
ZOOWORK_API_KEY=
# Max store pages the agent checks per search, and how long to wait for it
ZOOWORK_MAX_PAGES=8
# Store pages confirmed in parallel (one ZooWork agent each)
ZOOWORK_CONCURRENCY=3
# Reuse a store page's confirmation (in memory) for this long
OFFER_CACHE_MINUTES=30
ZOOWORK_TIMEOUT_MS=180000
# Type-ahead suggestions (1 Tavily credit per new lookup; cached)
SUGGESTIONS=on
SUGGEST_DEPTH=ultra-fast
SUGGEST_CACHE_HOURS=168

# Moss product catalog for type-ahead (uses MOSS_PROJECT_ID / MOSS_PROJECT_KEY)
MOSS_CATALOG=true
CATALOG_INDEX=pricescout-products
CATALOG_SIZE=100000
CATALOG_TIMEOUT_MS=400
# Import the catalog automatically on first start (Amazon Reviews 2023, ~3–5 GB streamed once)
CATALOG_AUTO_IMPORT=true
# CATALOG_ALLOW_HF=true   # fall back to the (larger) Hugging Face mirror if the UCSD server is unreachable
# Moss search persistence — off; set MOSS_ENABLED=true to persist store confirmations
MOSS_ENABLED=false
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX=pricescout-cache
