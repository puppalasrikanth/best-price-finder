# Get a key at https://app.tavily.com (free plan: 1,000 credits/month)
TAVILY_API_KEY=tvly-your-key-here

# Optional
PORT=3000
# advanced = 2 credits/search (better results), basic = 1 credit/search
SEARCH_DEPTH=advanced
# Repeat searches within this window are served from memory (no credits used)
CACHE_MINUTES=30

# ZooWork project key (zwp_live_...) from https://platform.zoowork.ai
# When set, a ZooWork agent opens each store page and confirms the price.
ZOOWORK_API_KEY=
# Max store pages the agent checks per search, and how long to wait for it
ZOOWORK_MAX_PAGES=8
# Store pages confirmed in parallel (one ZooWork agent each)
ZOOWORK_CONCURRENCY=3
# Reuse a store page's saved confirmation for this long
OFFER_CACHE_HOURS=6
ZOOWORK_TIMEOUT_MS=180000
# Type-ahead suggestions (1 Tavily credit per new lookup; cached)
SUGGESTIONS=on
SUGGEST_DEPTH=ultra-fast
SUGGEST_CACHE_HOURS=168

# Moss persistence (https://moss.dev) — saves every Tavily/ZooWork result for instant repeat searches
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX=pricescout-cache
# Serve saved prices instantly for 30 min; show older ones (up to 48 h) as a preview while refreshing
SEARCH_STALE_HOURS=48
